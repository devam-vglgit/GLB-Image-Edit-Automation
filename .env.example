# Copy this file to ".env" and fill in your real keys.
# The .env file is git-ignored and never sent to the browser.

# Google Gemini (AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# Note: gpt-image-1 requires organization verification on your OpenAI account.
OPENAI_API_KEY=

# Optional overrides if the providers rename their models
# GEMINI_MODEL=gemini-2.5-flash-image
# OPENAI_MODEL=gpt-image-1

# Optional: port (default 3000)
# PORT=3000

# Session signing secret (for the login cookie). If unset, a random one is
# generated on each server start, which logs everyone out on every restart —
# set a fixed value here to persist sessions across restarts.
# SESSION_SECRET=

# Cloudflare Turnstile (bot-check on the login form) — get both from the
# Cloudflare dashboard → Turnstile → add a widget. Login works normally
# without these; the widget only appears once TURNSTILE_SECRET_KEY is set.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── User accounts ──
# Accounts live in SQL Server (dbo.visualoom_users) and are managed by an
# admin from the Users screen. No login credentials belong in this file.
#
# AUTH_SEED is a bootstrap escape hatch ONLY: it is read when that table is
# empty (a brand-new database, or one that has been cleared), to create the
# first account so someone can sign in and take over from the UI. Leave it
# unset in normal operation, and clear it again once the first admin exists.
# Format: email:password:role
# AUTH_SEED=first.admin@vaibhavglobal.com:choose-a-strong-one:admin

# ── Database (required) ──
# The app creates and uses only its own dbo.visualoom_users table.
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
# Set to true once the server presents a certificate that can be validated.
DB_ENCRYPT=false
